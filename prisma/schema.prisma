generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName          String?
  lastName           String?
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  username           String?   @unique
  identityId         String?   @unique
  bio                String?   @db.String
  password           String?
  role               Role      @default(STUDENT)
  isActive           Boolean   @default(true)
  isEmailVerified    Boolean   @default(false)
  onboardingCompleted Boolean  @default(false)
  acceptedTermsAt     DateTime?
  acceptedPrivacyAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  instructorCourses  Course[]              @relation("InstructorCourses")
  enrollments        Enrollment[]
  videoProgress      VideoProgress[]
  quizAttempts       QuizAttempt[]
  certificates       CompletionCertificate[]
  reviews            Review[]
  bookmarks          Bookmark[]
  notes              Note[]
  discussionQuestions DiscussionQuestion[]
  discussionReplies   DiscussionReply[]
  discussionVotes     DiscussionVote[]
  coupons            Coupon[]
  couponUsages       CouponUsage[]
  deletedTrashItems  TrashItem[] @relation("DeletedTrashItems")

  @@map("users")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  token     String
  expires   DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([email, token])
  @@map("passwordresettokens")
}

model Course {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  thumbnail    String?
  instructorId String   @db.ObjectId
  isPublished  Boolean  @default(false)
  adminApproved Boolean  @default(false)
  approvedAt   DateTime?
  price        Float    @default(0.0)
  currency     String   @default("USD")
  isFree       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor   User                   @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  videos       Video[]
  quizzes      Quiz[]
  certificates CompletionCertificate[]
  reviews      Review[]
  courseNotes  CourseNote[]
  documents    CourseDocument[]
  bookmarks    Bookmark[]
  coupons      Coupon[]
  couponUsages CouponUsage[]

  @@map("courses")
}

model Enrollment {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  userId           String         @db.ObjectId
  courseId         String         @db.ObjectId
  enrolledAt       DateTime       @default(now())
  completedAt      DateTime?
  couponId         String?        @db.ObjectId
  discountApplied  Float          @default(0.0)
  finalPrice       Float          @default(0.0)
  paymentStatus    PaymentStatus  @default(PENDING)
  stripePaymentId  String?
  stripeSessionId  String?
  paidAt           DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  coupon  Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@unique([userId, courseId])
  @@map("enrollments")
}

model CourseNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   String   @db.String
  order     Int      @default(0)
  courseId  String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_notes")
}

model CourseDocument {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  url          String
  fileName     String
  mimeType     String
  size         Int
  resourceType String   @default("raw")
  order        Int      @default(0)
  courseId     String   @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_documents")
}

model TrashItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  entityType  String
  entityId    String
  courseId    String?  @db.ObjectId
  deletedById String   @db.ObjectId
  payload     Json
  deletedAt   DateTime @default(now())

  deletedBy User @relation("DeletedTrashItems", fields: [deletedById], references: [id], onDelete: Cascade)

  @@index([entityType])
  @@index([entityId])
  @@index([deletedById])
  @@map("trash_items")
}

model Video {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  url         String
  thumbnail   String?
  duration    Int?
  order       Int      @default(0)
  unlockType  UnlockType @default(IMMEDIATE)
  unlockDays  Int?
  unlockDate  DateTime?
  courseId    String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  VideoProgress[]
  notes     Note[]
  discussionQuestions DiscussionQuestion[]

  @@map("videos")
}

model VideoProgress {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  videoId        String   @db.ObjectId
  watchedSeconds Int      @default(0)
  completed      Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("video_progress")
}

model Quiz {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  courseId     String     @db.ObjectId
  createdAt    DateTime   @default(now())
  passingScore Int        @default(60)
  type         QuizType   @default(MAIN)

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   Question[]
  attempts    QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  text          String
  options       String[]
  correctAnswer Int
  quizId        String @db.ObjectId
  order         Int    @default(0)
  marks         Int    @default(1)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model QuizAttempt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  quizId      String   @db.ObjectId
  score       Int
  totalScore  Int
  answers     Json?
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model CompletionCertificate {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  courseId           String   @db.ObjectId
  certificateNumber  String   @unique
  issuedAt           DateTime @default(now())
  certificateUrl     String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("completion_certificates")
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  courseId  String   @db.ObjectId
  rating    Int      @default(5) // 1-5 stars
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("reviews")
}

model Bookmark {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  courseId  String   @db.ObjectId
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("bookmarks")
}

model Note {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  videoId   String   @db.ObjectId
  timestamp Int      @default(0) // seconds in video
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId, timestamp])
  @@map("notes")
}

model DiscussionQuestion {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  videoId     String   @db.ObjectId
  userId      String   @db.ObjectId
  content     String
  isResolved  Boolean  @default(false)
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies DiscussionReply[]
  votes   DiscussionVote[]

  @@map("discussion_questions")
}

model DiscussionReply {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  questionId       String   @db.ObjectId
  userId           String   @db.ObjectId
  content          String
  isInstructorReply Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  question DiscussionQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes    DiscussionVote[]

  @@map("discussion_replies")
}

model DiscussionVote {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  questionId  String?  @db.ObjectId
  replyId     String?  @db.ObjectId
  vote        Int      @default(1) // 1 for upvote, -1 for downvote (optional)
  createdAt   DateTime @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  question DiscussionQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reply    DiscussionReply?    @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId, replyId])
  @@map("discussion_votes")
}

model Coupon {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  code          String   @unique
  description   String?
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float
  maxUses       Int?     // null = unlimited
  usedCount     Int      @default(0)
  courseId      String?  @db.ObjectId // null = global coupon
  instructorId  String   @db.ObjectId
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course     Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor User    @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  usages     CouponUsage[]
  enrollments Enrollment[]

  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  couponId  String   @db.ObjectId
  userId    String   @db.ObjectId
  courseId  String   @db.ObjectId
  usedAt    DateTime @default(now())
  discountApplied Float

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, courseId])
  @@map("coupon_usages")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum QuizType {
  MAIN
  SUPPLEMENTAL
}

enum UnlockType {
  IMMEDIATE
  DAYS_AFTER_ENROLLMENT
  SPECIFIC_DATE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

model Payment {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  enrollmentId     String       @db.ObjectId
  stripePaymentId  String       @unique
  stripeSessionId  String       @unique
  amount           Float
  currency         String       @default("USD")
  status           PaymentStatus @default(PENDING)
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("payments")
}

